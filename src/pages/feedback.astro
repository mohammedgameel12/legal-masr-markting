---
import App from "../App.jsx";
import "../index.css";
const location = Astro.url.pathname;
const title = "الملاحظات والإبلاغ عن الأخطاء | ليجال مصر";
const description = "شاركنا ملاحظاتك أو أبلغ عن مشكلة أو اقترح ميزة جديدة لمساعدتنا على تحسين ليجال مصر.";
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#064e3f" />
<meta name="description" content={description} />
<meta name="robots" content="index,follow" />
<title>{title}</title>
<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Legal Masr" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
</head>
<body>
<App location={location} client:load />
</body>
</html>