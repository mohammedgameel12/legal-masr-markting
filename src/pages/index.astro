---
import App from "../App.jsx";
import "../index.css";
const location = Astro.url.pathname;
const title = "ليجال مصر | مكتبك القانوني على جهازك";
const description = "برنامج مجاني للمحامي المصري الفردي لإدارة القضايا والجلسات والموكلين والأتعاب دون إنترنت. الإصدار التجريبي v0.2.4 لنظام Windows وLinux.";
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#064e3f" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <title>{title}</title>
<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Legal Masr" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Legal Masr" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <App location={location} client:load />
  </body>
</html>
